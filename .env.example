# Copy to .env (never commit the real file). No real credentials belong in this example.

# --- core ---
ENV=development                      # set to "production" to refuse the default SECRET_KEY
SECRET_KEY=change-me-to-a-long-random-string   # signs tokens AND derives the file-encryption key. Rotating it invalidates sessions and stored files.
DATABASE_URL=sqlite:///./jobpilot.db # postgresql+psycopg://user:pass@host:5432/jobpilot for production
STORAGE_DIR=./storage                # encrypted resume/document storage (swap Storage class for S3)
CORS_ORIGINS=["http://localhost:3000"]

# --- Google sign-in (optional; leave blank to hide the button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# --- behaviour ---
SANDBOX_MODE=true                    # true: the only submitter is a TEST DOUBLE that never contacts employers
REQUIRE_EMAIL_VERIFICATION=false
ACCESS_TOKEN_MINUTES=480
MAX_UPLOAD_MB=5
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=300

# --- scheduler / workers ---
SCHEDULER_POLL_SECONDS=60            # how often the scheduler checks which profiles are due (interval itself is per-user, default 24h)
MAX_TASK_RETRIES=3
RETRY_BASE_SECONDS=1.0
LOCK_TTL_SECONDS=3600
REDIS_URL=                           # only needed for the optional Celery deployment (app/worker.py)

# --- AI ---
LLM_PROVIDER=rules                   # "rules" = deterministic, local. No third-party AI is called.

# --- frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker compose ---
POSTGRES_PASSWORD=change-me
